{
  "realm": "agro",
  "displayName": "TPI Backend agro",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 7200,
  "roles": {
    "realm": [
      { "name": "PRODUCTOR", "description": "Gestiona sus establecimientos, lotes y campañas; registra monitoreos y aplicaciones en lo suyo." },
      { "name": "OPERARIO", "description": "Registra monitoreos y aplicaciones en los establecimientos donde está asignado." },
      { "name": "AGRONOMO", "description": "Administra el catálogo, corrige datos de suelo y autoriza aplicaciones pendientes." }
    ]
  },
  "clients": [
    {
      "clientId": "agro-cliente",
      "name": "Cliente de prueba (Postman)",
      "description": "Cliente público para obtener tokens en las pruebas. Admite usuario y contraseña (password) y Authorization Code.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://oauth.pstmn.io/v1/callback",
        "http://localhost:8080/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "id": "11111111-1111-1111-1111-000000000001",
      "username": "productor1",
      "email": "productor1@agro.test",
      "firstName": "Pedro",
      "lastName": "Productor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "productor1", "temporary": false }],
      "realmRoles": ["PRODUCTOR"]
    },
    {
      "id": "11111111-1111-1111-1111-000000000002",
      "username": "productor2",
      "email": "productor2@agro.test",
      "firstName": "Paula",
      "lastName": "Productora",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "productor2", "temporary": false }],
      "realmRoles": ["PRODUCTOR"]
    },
    {
      "id": "22222222-2222-2222-2222-000000000001",
      "username": "operario1",
