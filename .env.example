# Copiar a .env y cambiar las contraseñas. El .env NO se sube al repo.

# Superusuario de PostgreSQL (solo para administrar; los servicios no lo usan)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_postgres

# Un usuario por microservicio, con permisos solo sobre su esquema
CAMPOS_DB_PASSWORD=cambiar_campos
TRATAMIENTOS_DB_PASSWORD=cambiar_tratamientos

# Usuario de la base keycloak
KEYCLOAK_DB_PASSWORD=cambiar_keycloak
